{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "../..",
    "rootDirs": ["src", "../../src/lib/content-engine"]
  },
  "include": ["src/**/*.ts", "../../src/lib/content-engine/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/__tests__"]
}

# Fragment environment variables
#
# You do NOT need any of these to run Fragment locally.
# Clone, `npm install`, `npm run dev`, and open http://localhost:3100.
# Add your AI provider in Settings > AI (bring your own key), or click
# "Sign in with ChatGPT" for Codex. Everything below is optional and only
# matters if you self-host the server or want server-side fallback keys.
#
# To use any of these: copy this file to `.env.local` and fill in values.
#   cp .env.example .env.local

# --- AI provider keys (optional server-side fallback) ---
# Normally users add their own key in the Settings UI. These are only read
# by the server as a fallback for self-hosters who want a shared key.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=

# --- Build / hosting flags (optional) ---
# "true" only for the managed hosted SaaS build. Leave unset to self-host.
NEXT_PUBLIC_FRAGMENT_HOSTED=

# --- Backend + telemetry (optional; unset = disabled, no errors) ---
# Convex HTTP actions endpoint (https://xxx.convex.site). Unset = local-only.
NEXT_PUBLIC_CONVEX_SITE_URL=
# Sentry error tracking DSN. Unset = error reporting off.
NEXT_PUBLIC_SENTRY_DSN=
# PostHog product analytics. Unset = analytics off.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

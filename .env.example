# Fragment environment variables
#
# You do NOT need any of these to run Fragment locally.
# Clone, `npm install`, `npm run dev`, and open http://localhost:3100.
# Add your AI provider in Settings > AI (bring your own key), or click
# "Sign in with ChatGPT" for the experimental Codex connection. Everything
# below is optional and matters only when you enable the corresponding service.
#
# To use any of these: copy this file to `.env.local` and fill in values.
#   cp .env.example .env.local

# --- Managed AI (disabled by default) ---
# Normally users connect a provider in Settings and its credential stays on
# that device. Deployment-owned keys are ignored unless BOTH hosted mode and
# FRAGMENT_ENABLE_MANAGED_AI=true are set. Do not enable this on a public app
# without authenticated access controls, quotas, and abuse protection.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
FRAGMENT_ENABLE_MANAGED_AI=

# --- Build / hosting flags (optional) ---
# "true" only for the managed hosted SaaS build (the private fragment-cloud
# repo, not this one). Leave unset to self-host - this repo has no accounts,
# no cloud storage, and no sync built in; that layer is closed-source.
NEXT_PUBLIC_FRAGMENT_HOSTED=

# Absolute URL of the Fragment server, for builds that are not served by it.
# The Tauri desktop build is a static export with no API routes of its own and
# needs this to reach a deployment. The web app leaves it unset (same origin).
NEXT_PUBLIC_FRAGMENT_API_BASE=

# --- Telemetry (optional; unset = disabled, no errors) ---
# Sentry error tracking DSN. Unset = error reporting off.
NEXT_PUBLIC_SENTRY_DSN=
# PostHog product analytics. Unset = analytics off.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

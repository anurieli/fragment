# Fragment environment variables
#
# You do NOT need any of these to run Fragment locally.
# Clone, `npm install`, `npm run dev`, and open http://localhost:3100.
# Add your AI provider in Settings > AI (bring your own key), or click
# "Sign in with ChatGPT" for Codex. Everything below is optional and only
# matters if you self-host the server or want server-side fallback keys.
#
# To use any of these: copy this file to `.env.local` and fill in values.
#   cp .env.example .env.local

# --- AI provider keys (optional server-side fallback) ---
# Normally users add their own key in the Settings UI. These are only read
# by the server as a fallback for self-hosters who want a shared key.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=

# --- Build / hosting flags (optional) ---
# "true" only for the managed hosted SaaS build. Leave unset to self-host.
NEXT_PUBLIC_FRAGMENT_HOSTED=

# --- Cloud sync (optional; unset = local-only, no errors) ---
# Postgres connection string. Set this and the app gains accounts and sync
# across devices; leave it unset and Fragment stays entirely local-first,
# which is the default and a fully supported way to run it.
#   npm run db:migrate   applies db/migrations/*.sql
DATABASE_URL=
# "true" when connecting to a Postgres that requires TLS (most hosted ones).
DATABASE_SSL=
# Set to "false" ONLY for local http development. Session cookies are marked
# Secure by default and a browser will not store them over plain http.
SESSION_COOKIE_SECURE=
# Where feedback attachments are written. Defaults to ~/.fragment/blobs.
FRAGMENT_BLOB_DIR=
# Absolute URL of the Fragment server, for builds that are not served by it.
# The Tauri desktop build is a static export with no API routes of its own and
# needs this to reach a deployment. The web app leaves it unset (same origin).
NEXT_PUBLIC_FRAGMENT_API_BASE=

# --- Telemetry (optional; unset = disabled, no errors) ---
# Sentry error tracking DSN. Unset = error reporting off.
NEXT_PUBLIC_SENTRY_DSN=
# PostHog product analytics. Unset = analytics off.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
